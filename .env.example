BOT_TOKEN=123456:ABC...            # токен от @BotFather
BASE_URL=https://your-app.up.railway.app   # публичный HTTPS-адрес сервиса
OWNER_IDS=111111111                # ваш Telegram ID (узнать: команда /id у бота), несколько через запятую
TZ_NAME=Asia/Novosibirsk           # часовой пояс вуза
DATA_DIR=/data                     # папка с базой (подключите Volume!)
# Шаблон ссылки на расписание по названию группы (необязательно), {group} подставится автоматически:
# SCHEDULE_URL_TEMPLATE=https://example-vuz.ru/schedule/{group}.ics
MARK_BEFORE_MIN=15                 # за сколько минут до пары можно отмечаться
MARK_AFTER_MIN=30                  # сколько минут после конца пары можно отмечаться
